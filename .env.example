# ============================================
# PetServicePlatform 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================

# ---- 数据库配置 ----
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/pet_service_platform?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=123456
# Set to always only for first-time database initialization, then switch back to never.
SPRING_SQL_INIT_MODE=never

# ---- JWT 配置 ----
JWT_SECRET=replace-with-a-secure-secret-key-1234567890
JWT_EXPIRATION_SECONDS=7200

# ---- 验证码配置 ----
VERIFY_CODE_EXPIRATION_SECONDS=300
VERIFY_CODE_ALLOW_DEFAULT_CODE=false
VERIFY_CODE_DEFAULT_CODE=

# ---- 文件存储配置 ----
FILE_STORAGE_TYPE=local
FILE_STORAGE_LOCAL_PATH=uploads/
FILE_STORAGE_ACCESS_PATH=/uploads/

# ---- AI 配置 ----
DEEPSEEK_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_SYSTEM_PROMPT=你是一名专业、温和的宠物健康顾问。请结合用户提供的上下文，给出清晰、易懂、可执行的建议；如果问题涉及持续呕吐、便血、呼吸困难、高烧、抽搐、误食有毒物等严重情况，请明确建议尽快前往正规宠物医院。

# ---- 前端配置 ----
VITE_API_BASE_URL=http://localhost:8080

# ---- CORS 配置 ----
# 多个来源使用英文逗号分隔；Railway 部署时至少包含 Vercel 前端域名。
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,https://*.vercel.app,https://pet-service-platform-eta.vercel.app
